<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- libfuzzer-dotnet 驱动 + 插桩仅支持 Linux/macOS；与主库同用 .NET 10 -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AigcTotal.Fuzz</RootNamespace>
    <AssemblyName>AigcTotal.Fuzz</AssemblyName>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpFuzz" />
    <ProjectReference Include="..\..\src\AigcTotal.GB45438\AigcTotal.GB45438.csproj" />
    <ProjectReference Include="..\..\src\AigcTotal.Log\AigcTotal.Log.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 各 fuzz 目标的种子语料（libFuzzer 起点；docs/fuzzing.md 的 seeds/<target> 路径由此拷贝） -->
    <Content Include="seeds\**\*.*" CopyToOutputDirectory="PreserveNewest" Link="seeds\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>

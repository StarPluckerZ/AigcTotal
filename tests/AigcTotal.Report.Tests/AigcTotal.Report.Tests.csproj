<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AigcTotal.GB45438\AigcTotal.GB45438.csproj" />
    <ProjectReference Include="..\..\src\AigcTotal.Report\AigcTotal.Report.csproj" />
    <ProjectReference Include="..\..\src\AigcTotal.Report.Cli\AigcTotal.Report.Cli.csproj" />
    <ProjectReference Include="..\AigcTotal.TestSupport\AigcTotal.TestSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 全量语料进测试输出：golden 测试按语料名逐一重建并逐字节比对 -->
    <Content Include="..\..\samples\corpus\**\*.*" Link="corpus\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Golden\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AigcTotal.Report.Cli</RootNamespace>
    <AssemblyName>aigc-report</AssemblyName>
    <Version>0.1.0</Version>
    <Description>aigc-report — official CLI reference implementation of the AigcTotal verification report.</Description>
    <!-- dotnet tool 发布形态（PackAsTool） -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>aigc-report</ToolCommandName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AigcTotal.Report\AigcTotal.Report.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AigcTotal.Verify.Cli</RootNamespace>
    <AssemblyName>aigc-verify</AssemblyName>
    <Version>0.1.0</Version>
    <Description>aigc-verify — third-party verification CLI for the AigcTotal transparency log (report signatures, Merkle inclusion, checkpoint chains, external anchors).</Description>
    <!-- dotnet tool 发布形态（PackAsTool），包名 AigcTotal.Verify -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>aigc-verify</ToolCommandName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AigcTotal.Log\AigcTotal.Log.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 透明日志与存证签名库：Merkle/段文件/checkpoint/keys 状态机/ES256 线格式。
         多目标零第三方依赖；仅依赖 AigcTotal.Report（canonical JSON 单一来源），与 GB45438 互不引用。 -->
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <RootNamespace>AigcTotal.Log</RootNamespace>
    <AssemblyName>AigcTotal.Log</AssemblyName>
    <Version>0.1.0</Version>
    <Description>Transparency log primitives for AigcTotal attestation reports: RFC 6962 Merkle trees, append-only segments, checkpoint chain, key state machine, ES256 wire format.</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1510;CA1512</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AigcTotal.Report\AigcTotal.Report.csproj" />
  </ItemGroup>

</Project>
